# Stage 1: Build/install tools in dev container
FROM dhi.io/node:25-debian13-dev@sha256:aa7e54aa027bc9404173a09c85b8380b53c37c908ca8ff36e18e6ecc2b264d1d AS builder

RUN apt-get update && apt-get install -y --no-install-recommends strace \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm --force

COPY entrypoint-pnpm.sh /tmp/entrypoint.sh
RUN chmod +x /tmp/entrypoint.sh

# Bundle strace + shell + libs into one directory
RUN mkdir -p /tmp/bundle/bin /tmp/bundle/lib \
    && cp /usr/bin/strace /tmp/bundle/bin/ \
    && cp /bin/bash /tmp/bundle/bin/ \
    && ln -s bash /tmp/bundle/bin/sh \
    && printf '#!/bin/sh\nnode /usr/local/lib/node_modules/pnpm/bin/pnpm.cjs "$@"\n' > /tmp/bundle/bin/pnpm \
    && chmod +x /tmp/bundle/bin/pnpm \
    && for bin in /usr/bin/strace /bin/bash; do \
         for lib in $(ldd "$bin" 2>/dev/null | grep "=>" | awk '{print $3}'); do \
           cp "$lib" /tmp/bundle/lib/ 2>/dev/null || true; \
         done; \
       done

# Stage 2: Hardened non-root runtime
FROM dhi.io/node:25-debian13@sha256:36b558fa9be97d6416770a7be2d35f37797d814f13a3d9e23dfff8a1a4615090

COPY --from=builder /tmp/bundle/bin/strace /usr/bin/strace
COPY --from=builder /tmp/bundle/bin/bash /bin/bash
COPY --from=builder /tmp/bundle/bin/sh /bin/sh
COPY --from=builder /tmp/bundle/lib/ /usr/lib/
COPY --from=builder /usr/bin/env /usr/bin/env
COPY --from=builder /opt/nodejs/node-v25.8.2/lib/node_modules/pnpm/ /usr/local/lib/node_modules/pnpm/
COPY --from=builder /tmp/bundle/bin/pnpm /usr/local/bin/pnpm
COPY --from=builder /tmp/entrypoint.sh /usr/local/bin/entrypoint.sh

WORKDIR /sandbox
ENV HOME=/sandbox
USER 10001:10001

ENTRYPOINT ["/usr/bin/strace", "-f", "-e", "trace=network,process,openat", "-o", "/strace/strace.log", "--", "/usr/local/bin/entrypoint.sh"]
