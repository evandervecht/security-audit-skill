# Stage 1: SDK in dev container
FROM dhi.io/dotnet/sdk:8.0-alpine@sha256:608d8a4b570b88bd8b1fbb792f00cee88d557eee3a56ebf06b359fdea05a50ed AS builder

RUN apk add --no-cache strace

# Stage 2: Hardened non-root runtime
FROM dhi.io/dotnet/sdk:8.0-alpine@sha256:608d8a4b570b88bd8b1fbb792f00cee88d557eee3a56ebf06b359fdea05a50ed

COPY --from=builder /usr/bin/strace /usr/bin/strace

RUN rm -rf /var/cache/apk/* /tmp/*

# Create non-root user with restricted home
RUN addgroup -S sandbox && adduser -S -G sandbox -h /sandbox -s /sbin/nologin sandbox

# .NET needs writable NuGet cache
ENV DOTNET_CLI_HOME=/sandbox/.dotnet
ENV NUGET_PACKAGES=/sandbox/.nuget
RUN mkdir -p /sandbox/.dotnet /sandbox/.nuget && chown -R sandbox:sandbox /sandbox

WORKDIR /sandbox

# Drop to non-root
USER sandbox:sandbox

ENTRYPOINT ["strace", "-f", "-e", "trace=network,process,openat", "-o", "/tmp/strace.log", "--", "dotnet", "restore"]
