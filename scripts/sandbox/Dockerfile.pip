# Stage 1: Build tools in dev container
FROM dhi.io/python:3.13-alpine@sha256:bb1f2fdb1065c85468775c9d680dcd344f6442a2d1181ef7916b60a623f11d40 AS builder

RUN apk add --no-cache strace
# Install uv (fast Python package manager) and pip-audit
RUN pip install --no-cache-dir uv pip-audit

# Stage 2: Hardened non-root runtime
FROM dhi.io/python:3.13-alpine@sha256:bb1f2fdb1065c85468775c9d680dcd344f6442a2d1181ef7916b60a623f11d40

COPY --from=builder /usr/bin/strace /usr/bin/strace
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv
COPY --from=builder /usr/local/bin/pip-audit /usr/local/bin/pip-audit
COPY --from=builder /usr/local/lib/python3.13/site-packages/ /usr/local/lib/python3.13/site-packages/

RUN rm -rf /var/cache/apk/* /tmp/*

# Create non-root user with restricted home
RUN addgroup -S sandbox && adduser -S -G sandbox -h /sandbox -s /sbin/nologin sandbox

# Entrypoint script: install with uv + pip-audit
COPY entrypoint-pip.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /sandbox

# Drop to non-root
USER sandbox:sandbox

ENTRYPOINT ["strace", "-f", "-e", "trace=network,process,openat", "-o", "/tmp/strace.log", "--", "/usr/local/bin/entrypoint.sh"]
