# Stage 1: Build/install in dev container
FROM dhi.io/library/python:3.13-alpine@sha256:bb1f2fdb1065c85468775c9d680dcd344f6442a2d1181ef7916b60a623f11d40 AS builder

RUN apk add --no-cache strace

# Stage 2: Hardened non-root runtime
FROM dhi.io/library/python:3.13-alpine@sha256:bb1f2fdb1065c85468775c9d680dcd344f6442a2d1181ef7916b60a623f11d40

COPY --from=builder /usr/bin/strace /usr/bin/strace

RUN rm -rf /var/cache/apk/* /tmp/*

# Create non-root user with restricted home
RUN addgroup -S sandbox && adduser -S -G sandbox -h /sandbox -s /sbin/nologin sandbox
WORKDIR /sandbox

# Drop to non-root
USER sandbox:sandbox

ENTRYPOINT ["strace", "-f", "-e", "trace=network,process,openat", "-o", "/tmp/strace.log", "--", "pip", "install", "--user", "--no-warn-script-location"]
