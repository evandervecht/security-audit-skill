# Stage 1: Build/install tools in dev container
FROM dhi.io/node:25-debian13-dev@sha256:aa7e54aa027bc9404173a09c85b8380b53c37c908ca8ff36e18e6ecc2b264d1d AS builder

RUN apt-get update && apt-get install -y --no-install-recommends strace \
    && rm -rf /var/lib/apt/lists/*

# Stage 2: Hardened non-root runtime
FROM dhi.io/node:25-debian13@sha256:36b558fa9be97d6416770a7be2d35f37797d814f13a3d9e23dfff8a1a4615090

COPY --from=builder /usr/bin/strace /usr/bin/strace

# Create non-root user with restricted home
RUN addgroup --system sandbox && adduser --system --ingroup sandbox --home /sandbox --shell /bin/false sandbox

# Entrypoint script: install + npm audit
COPY entrypoint-npm.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /sandbox

# Drop to non-root
USER sandbox:sandbox

ENTRYPOINT ["strace", "-f", "-e", "trace=network,process,openat", "-o", "/tmp/strace.log", "--", "/usr/local/bin/entrypoint.sh"]
