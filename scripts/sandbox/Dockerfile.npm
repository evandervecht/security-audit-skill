# Minimal Node.js image for sandboxed npm install
FROM node:20-alpine

# Install strace for syscall monitoring
RUN apk add --no-cache strace

# Create non-root user
RUN adduser -D -h /sandbox sandbox
WORKDIR /sandbox

# Drop to non-root
USER sandbox

# Entry point: strace monitors npm install
ENTRYPOINT ["strace", "-f", "-e", "trace=network,process,openat", "-o", "/tmp/strace.log", "--", "npm", "install", "--ignore-scripts=false"]
